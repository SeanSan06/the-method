# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
#   Only the entries an application repo actually produces. The stock Python
#   template also lists lib/, var/, parts/, sdist/, wheels/, share/ and friends,
#   but those are unanchored and match at any depth, so they would silently
#   swallow a future backend/lib/ package.
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#   Usually these files are written by a python script from a template
#   before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
coverage/
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# pyenv
.python-version

# Lockfiles are intentionally NOT ignored (frontend/package-lock.json is
#   committed). The stock template ignores Pipfile.lock, uv.lock, poetry.lock
#   and pdm.lock, which would silently drop a lockfile if we ever adopt one of
#   those tools. Frontend uses npm; backend uses pip-tools via requirements.in.
poetry.toml
pdm.toml
.pdm-python
.pdm-build/

# pixi
.pixi

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# Redis
*.rdb
*.aof
*.pid

# RabbitMQ
mnesia/
rabbitmq/
rabbitmq-data/

# ActiveMQ
activemq-data/

# SageMath parsed files
*.sage.py

# Environments
#   .env.* covers .env.production, .env.staging, .env.local etc. Both
#   frontend/.dockerignore and backend/.dockerignore already ignore .env.*, so
#   git was the only one still letting them through.
.env
.env.*
!.env.example
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# Abstra
.abstra/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Streamlit
.streamlit/secrets.toml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node-specific ignores
node_modules
dist-ssr
*.local

# Runtime-cloned dataset
#   interview/refresh.py runs `git clone DATA_URL backend/interview/data`, so
#   this folder becomes a whole nested repo (its own .git) plus CSVs. Left
#   unignored, `git add .` stages it as a submodule pointer (mode 160000)
#   instead of files, and fresh clones get an empty data dir. Anchored so a
#   future backend/data/ or backend/database/data/ is unaffected.
backend/interview/data/

# Editor directories and files
#   .vscode/* (not .vscode/) so git still descends into the directory and the
#   negation below can actually re-include the file.
.vscode/*
!.vscode/extensions.json
.idea/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Windows / Visual Studio cruft
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
